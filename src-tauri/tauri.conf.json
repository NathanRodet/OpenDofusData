{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-dofus-data-client",
  "version": "2.4.0",
  "identifier": "com.weac.open-dofus-data-client",
  "build": {
    "beforeDevCommand": "npm run worker && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run worker && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenDofusData",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/odd-capture-worker"
    ]
  }
}
